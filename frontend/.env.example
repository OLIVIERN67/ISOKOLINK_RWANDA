# Base URL of the ISOKOLINK REST API.
#
# Local development:
#   Leave empty to use the Vite dev proxy (recommended), or set
#   VITE_API_URL=http://localhost:5000 to call the backend directly.
#
# Production (Vercel):
#   Set this as an encrypted Environment Variable in the Vercel project:
#   VITE_API_URL=https://isokolink-rwanda.onrender.com
#
# Note: Vite embeds VITE_* variables into the public browser bundle, so never
# put database passwords or other true server secrets here. Use only the API URL.
VITE_API_URL=
