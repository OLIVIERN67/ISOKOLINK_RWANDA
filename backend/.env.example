# Runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Public URL of this API (used for building absolute image URLs)
API_PUBLIC_URL=http://localhost:5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=isokolink_rwanda
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=10

# Session
SESSION_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
SESSION_TTL_HOURS=168
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Verification / reset tokens (minutes)
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Email (optional; leave blank to disable outbound email and use dev token logging)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Dev convenience: when true, verification/reset tokens are returned by the API
# in non-production environments. NEVER enable in production.
EXPOSE_DEV_TOKENS=true
